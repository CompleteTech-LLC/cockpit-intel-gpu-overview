[Unit]
Description=Cockpit Intel GPU telemetry exporter
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/cockpit-intel-gpu-exporter --interval 2
Restart=on-failure
RestartSec=5
RuntimeDirectory=cockpit-intel-gpu
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/cockpit-intel-gpu

[Install]
WantedBy=multi-user.target

